# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Pluggy Open Finance API Configuration
# Leave blank to use realistic Mock Mode automatically.
# When ready, add your credentials from https://dashboard.pluggy.ai:
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_BASE_URL=https://api.pluggy.ai
# Set to 'false' when you want to enforce real Pluggy API calls
PLUGGY_MOCK_MODE=true

# Optional AI Key (OpenAI / Anthropic / Gemini) for advanced external model calling.
# The backend includes a smart Open Finance reasoning agent that works out of the box!
GEMINI_API_KEY=
